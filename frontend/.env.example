# URL gốc của Backend API (FastAPI) - dùng ở TRÌNH DUYỆT (client-side), xem
# giải thích đầy đủ trong CLAUDE.md ("NEXT_PUBLIC_API_URL luôn phải là URL
# truy cập được từ trình duyệt").
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL gốc Backend API dùng ở SERVER (task 4.2.1 - Server Component fetch SSR,
# VD app/(customer)/products/page.tsx) - chạy TRONG container/process
# Next.js, KHÔNG PHẢI trình duyệt, nên khác NEXT_PUBLIC_API_URL ở trên: khi
# chạy qua docker-compose.yml, biến này được override thành
# "http://backend:8000/api/v1" (tên service, chỉ resolve được trong network
# nội bộ Compose) - giá trị dưới đây chỉ đúng lúc chạy standalone (`npm run
# dev` ngoài Docker, xem CLAUDE.md mục Commands).
API_INTERNAL_URL=http://localhost:8000/api/v1
