# .env.example (gốc repo) — dùng bởi docker-compose.yml (task 2.3.1+), KHÁC
# với backend/.env.example (dùng khi chạy Backend KHÔNG qua Docker, vd
# `uvicorn --reload` trực tiếp trên máy, DATABASE_URL trỏ host.docker.internal
# hoặc localhost). Docker Compose tự đọc file `.env` cùng cấp với
# docker-compose.yml để thay thế các biến `${...}` trong file - không cần
# `--env-file` như `docker run` rời rạc.
#
# Copy file này thành `.env` rồi điền giá trị thật, KHÔNG commit `.env` thật
# (đã chặn trong .gitignore).

# ==== MySQL (service `mysql`, task 2.3.1) ====
MYSQL_ROOT_PASSWORD=changeme
# Tên database khớp với dữ liệu thật đã có trong container mysql-dev hiện tại
# (xem hướng dẫn migrate ở task 2.3.1) - PHẢI khớp DATABASE_URL trong
# backend/.env.example (đã đồng bộ, xem docs/KNOWN_TODOS.md #6).
MYSQL_DATABASE=ecommerce

# ==== MongoDB (service `mongodb`, task 2.3.2) ====
# Root user bootstrap cho MongoDB - tương tự vai trò MYSQL_ROOT_PASSWORD ở
# trên, KHÔNG phải app-level user riêng cho database ecommerce_mongo (đơn
# giản hoá cho project solo, cùng mức đơn giản đang dùng ở MySQL - cả 2 đều
# dùng thẳng tài khoản root, chưa tạo user riêng theo least-privilege).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# ==== Redis (service `redis`, task 2.3.3) ====
# Bật password (--requirepass, xem docker-compose.yml) thay vì để mở, dù data
# ở đây chỉ là cache/session tạm thời (mất không sao, khác MySQL/MongoDB) - lý
# do bật: (1) nhất quán tư thế bảo mật với 2 service kia thay vì biến Redis
# thành ngoại lệ duy nhất không auth trong stack, (2) chi phí gần như 0 (thêm
# 1 biến, đã có sẵn cơ chế .env cho 2 service kia), (3) port 6379 vẫn publish
# ra host theo yêu cầu debug bằng RedisInsight - có auth vẫn an toàn hơn nếu
# lỡ mở port ra ngoài máy (VD đổi cấu hình mạng sau này) mà quên tắt lại.
REDIS_PASSWORD=changeme
