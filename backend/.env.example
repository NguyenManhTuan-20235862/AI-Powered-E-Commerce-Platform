# ==== App ====
APP_NAME=AI-Powered E-Commerce Platform API
APP_ENV=development
DEBUG=True

# ==== MySQL (SQLAlchemy) ====
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
# Tên DB "ecommerce" phải khớp MYSQL_DATABASE trong docker-compose.yml (gốc
# repo, task 2.3.1) - đổi 1 bên thì đổi luôn bên kia, tránh lệch âm thầm.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecommerce

# ==== MongoDB ====
# authSource=admin là BẮT BUỘC, không phải tùy chọn: root user được tạo qua
# MONGO_INITDB_ROOT_USERNAME/PASSWORD (docker-compose.yml, task 2.3.2) chỉ
# tồn tại trong database "admin", không phải trong "ecommerce_mongo" - thiếu
# authSource=admin sẽ authenticate thất bại (đã tự kiểm chứng khi verify
# task 2.3.2).
MONGO_URI=mongodb://root:<password>@localhost:27017/?authSource=admin
MONGO_DB_NAME=ecommerce_mongo

# ==== Redis ====
# Format: redis://:<password>@<host>:<port>/<db_index> - LƯU Ý dấu ":" đứng
# NGAY SAU "//" (không có username phía trước như MySQL/MongoDB) - Redis
# requirepass (docker-compose.yml, task 2.3.3) chỉ có khái niệm password,
# không có username, khác cú pháp user:password@ quen thuộc của 2 DB kia.
REDIS_URL=redis://:<password>@localhost:6379/0

# ==== JWT ====
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== AI Agent (task 6.1.1) ====
# Mặc định trỏ Ollama chạy LOCAL trên máy host (MIỄN PHÍ, dùng cho dev) -
# Backend chạy trong container nên PHẢI gọi qua host.docker.internal (KHÔNG
# PHẢI localhost - localhost trong container trỏ vào chính container đó,
# không phải máy host, xem giải thích đầy đủ ở task 2.1.1). Cài Ollama +
# chạy model trước: `ollama pull llama3.2 && ollama serve` (mặc định expose
# API tương thích OpenAI tại cổng 11434).
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Ollama KHÔNG check giá trị này - để bất kỳ chuỗi khác rỗng nào cũng chạy
# được (ChatOpenAI/openai SDK bắt buộc phải có api_key, dù provider không
# dùng tới).
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Giới hạn độ dài response - giữ thói quen này dù Ollama miễn phí, để khi
# đổi sang OpenAI thật (xem backend/.env.production.example) đã có sẵn giới
# hạn chi phí.
LLM_MAX_TOKENS=1000
# Giây - tránh treo request khi LLM chậm/không phản hồi.
LLM_TIMEOUT=30

# ==== Scheduler (task 3.5.2) ====
# Cú pháp cron chuẩn (phút giờ ngày tháng thứ), giờ Việt Nam
# (Asia/Ho_Chi_Minh) - mặc định 2h sáng hàng ngày. Đổi giá trị này (VD
# "*/2 * * * *") để test lịch chạy gần mà không cần sửa code - xem
# backend/scripts/run_scheduler.py.
PRODUCT_SYNC_CRON=0 2 * * *

# ==== Payment - VNPay sandbox (task "Quyết định và hoàn thiện thanh toán") ====
# Đăng ký tài khoản sandbox tại https://sandbox.vnpayment.vn để lấy 2 giá trị
# này - THIẾU 1 trong 2, POST /payments/create trả 503 (chưa cấu hình), không
# crash app (Backend vẫn chạy bình thường cho mọi tính năng khác).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# CÓ THỂ giữ nguyên - URL cổng thanh toán sandbox VNPay (v2.1.0).
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL BACKEND đầy đủ (trình duyệt KHÁCH điều hướng thẳng tới đây sau khi
# thanh toán xong ở VNPay, KHÔNG PHẢI tên service Docker - cùng nguyên tắc
# NEXT_PUBLIC_API_URL) - trỏ đúng GET /payments/callback.
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payments/callback
# URL gốc FRONTEND - Backend dùng để tự điều hướng khách về lại trang kết quả
# thanh toán (/checkout/payment-result) sau khi xử lý callback.
FRONTEND_BASE_URL=http://localhost:3000
