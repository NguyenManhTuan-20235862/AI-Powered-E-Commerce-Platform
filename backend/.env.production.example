# backend/.env.production.example — task 2.4.2. File MẪU/TÀI LIỆU, liệt kê
# biến nào PHẢI đổi giá trị so với `.env.example` (dev) khi deploy thật -
# CHƯA có giá trị thật (chưa tới lúc deploy, xem task 7.5). Dùng khi Backend
# chạy bằng `Dockerfile.prod` (Gunicorn, xem `gunicorn_conf.py`).

# ==== App ====
APP_NAME=AI-Powered E-Commerce Platform API
# PHẢI đổi: "production" - tắt Swagger/ReDoc (settings.is_production, xem
# app/main.py), đổi log level mặc định INFO thay vì DEBUG (app/core/logging.py).
APP_ENV=production
# PHẢI đổi: False - True ở production sẽ lộ thông tin debug (traceback chi
# tiết...) ra response lỗi, rủi ro bảo mật thật.
DEBUG=False

# ==== MySQL (SQLAlchemy) ====
# PHẢI đổi: trỏ server MySQL thật (KHÔNG PHẢI localhost/host.docker.internal -
# 2 giá trị đó chỉ có nghĩa trên máy dev) - VD RDS endpoint, hoặc tên service
# nếu vẫn dùng Docker Compose trên 1 server. Password PHẢI khớp
# MYSQL_ROOT_PASSWORD thật trong `.env.production` (gốc repo).
DATABASE_URL=mysql+pymysql://root:<password>@<production-db-host>:3306/ecommerce

# ==== MongoDB ====
# PHẢI đổi - cùng lý do DATABASE_URL. authSource=admin vẫn giữ nguyên (không
# đổi theo môi trường - xem giải thích trong .env.example).
MONGO_URI=mongodb://root:<password>@<production-db-host>:27017/?authSource=admin
# CÓ THỂ giữ nguyên.
MONGO_DB_NAME=ecommerce_mongo

# ==== Redis ====
# PHẢI đổi - cùng lý do DATABASE_URL.
REDIS_URL=redis://:<password>@<production-db-host>:6379/0

# ==== JWT ====
# PHẢI đổi: random mạnh (VD `openssl rand -hex 32`), KHÔNG dùng lại giá trị
# dev ("dev-secret-key-change-in-production-..." - chính TÊN biến dev đã tự
# nhắc rồi) - lộ JWT_SECRET_KEY nghĩa là ai cũng tự ký được access token giả
# mạo bất kỳ user/role nào, rủi ro nghiêm trọng nhất trong toàn bộ file này.
JWT_SECRET_KEY=changeme
# CÓ THỂ giữ nguyên.
JWT_ALGORITHM=HS256
# CÓ THỂ giữ nguyên, cân nhắc rút ngắn hơn (VD 15-30 phút) nếu muốn chính sách
# bảo mật chặt hơn cho production - không bắt buộc phải đổi.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== AI Agent ====
# PHẢI đổi (khi task 6.x code AI Agent xong): API key thật từ OpenAI, KHÔNG
# commit dù chỉ 1 ký tự thật vào bất kỳ file .example nào.
OPENAI_API_KEY=

# ==== Scheduler (task 3.5.2) ====
# Cú pháp cron chuẩn, giờ Việt Nam (Asia/Ho_Chi_Minh) - mặc định 2h sáng
# hàng ngày, giờ ít traffic nhất. Giá trị giống dev trừ khi có lý do khác
# (VD muốn giờ chạy khác cho production thật).
PRODUCT_SYNC_CRON=0 2 * * *

# ==== Gunicorn (CHỈ áp dụng production - Dockerfile.prod, gunicorn_conf.py) ====
# Các biến này KHÔNG xuất hiện trong `.env.example` (dev) vì dev chạy
# `uvicorn --reload` trực tiếp, không qua Gunicorn - CHỈ có ý nghĩa khi chạy
# `Dockerfile.prod`. Phát hiện lúc rà soát task 2.4.2: đã tồn tại trong
# `gunicorn_conf.py` (đọc qua `os.getenv`) từ task 2.1.2 nhưng CHƯA từng được
# liệt kê ở bất kỳ file .env nào - chưa phải bug (đều có default hợp lý) nhưng
# dễ bị quên khi thực sự deploy.
#
# CÓ THỂ giữ nguyên default (8000) trừ khi hosting provider yêu cầu port khác.
PORT=8000
# NÊN set thẳng (không để tự tính theo công thức (2xCPU)+1) - xem comment
# trong gunicorn_conf.py: tự tính có thể sai nếu CPU của container bị giới hạn
# khác với CPU thật của host/VM. Set theo đúng số CPU THẬT của server production.
GUNICORN_WORKERS=4
# CÓ THỂ giữ nguyên default, điều chỉnh nếu server production chậm hơn/nhanh
# hơn đáng kể so với giả định ban đầu (30s).
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
# CÓ THỂ đổi xuống "warning" nếu log "info" quá nhiều ở production - "info"
# vẫn là lựa chọn an toàn/hợp lý để bắt đầu.
GUNICORN_LOG_LEVEL=info
