# .env.production.example (gốc repo) — task 2.4.2. File MẪU/TÀI LIỆU cho môi
# trường production, liệt kê biến nào PHẢI đổi giá trị so với `.env.example`
# (dev) khi thực sự deploy - CHƯA có giá trị thật (chưa tới lúc deploy, xem
# task 7.5), KHÔNG dùng để chạy `docker compose` trực tiếp ngay bây giờ.
#
# Dùng cùng cơ chế với `.env.example` (Docker Compose đọc file `.env` cùng
# cấp) - khi thực sự deploy: `cp .env.production.example .env.production` rồi
# điền giá trị thật, trỏ compose đọc file này bằng `--env-file .env.production`
# (docker-compose.yml hiện tại KHÔNG tự đọc `.env.production` - đó là tên file
# tùy chọn cho deploy, xem task 7.2 khi có docker-compose.prod.yml).

# ==== MySQL ====
# PHẢI đổi: password thật, độ dài/entropy cao (không phải "changeme"/số đơn
# giản như giá trị dev "130905" đang dùng) - dùng generator (VD: `openssl rand
# -base64 32`), lưu vào secret manager của hosting provider, KHÔNG gõ tay giá
# trị dễ đoán.
MYSQL_ROOT_PASSWORD=changeme
# CÓ THỂ giữ nguyên tên "ecommerce" (không bắt buộc đổi tên DB theo môi
# trường) - chỉ đổi nếu hosting yêu cầu quy ước tên riêng.
MYSQL_DATABASE=ecommerce

# ==== MongoDB ====
# PHẢI đổi - cùng lý do MYSQL_ROOT_PASSWORD.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# ==== Redis ====
# PHẢI đổi - cùng lý do MYSQL_ROOT_PASSWORD. Lưu ý: dù data Redis là cache/
# session tạm thời (mất không sao), PASSWORD vẫn phải mạnh - password yếu vẫn
# là điểm vào tấn công nếu port lỡ mở ra ngoài, không liên quan gì tới việc
# data bên trong có quan trọng hay không.
REDIS_PASSWORD=changeme
